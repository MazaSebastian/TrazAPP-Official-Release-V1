{
  "version": "2.8",
  "name": "TrazAPP V1 Design System",
  "description": "Design Tokens and Reusable UI Components for TrazAPP V1 Restyling",
  "tokens": {
    "colors": {
      "bgMain": "#0B0F17",
      "bgSurface": "#111827",
      "bgSurfaceElevated": "#1F2937",
      "bgGlass": "rgba(17, 24, 39, 0.75)",
      "borderDefault": "rgba(255, 255, 255, 0.08)",
      "borderHover": "rgba(16, 185, 129, 0.3)",
      "primary": "#10B981",
      "primaryHover": "#059669",
      "primaryGlow": "rgba(16, 185, 129, 0.25)",
      "textMain": "#F9FAFB",
      "textMuted": "#9CA3AF",
      "textSubtle": "#6B7280",
      "accentBlue": "#38BDF8",
      "accentAmber": "#F59E0B",
      "accentRose": "#F43F5E",
      "accentPurple": "#A855F7"
    },
    "typography": {
      "fontFamily": "Inter, system-ui, sans-serif",
      "heading1": { "fontSize": "2rem", "fontWeight": "800", "lineHeight": "1.2" },
      "heading2": { "fontSize": "1.5rem", "fontWeight": "700", "lineHeight": "1.3" },
      "heading3": { "fontSize": "1.125rem", "fontWeight": "600", "lineHeight": "1.4" },
      "body": { "fontSize": "0.875rem", "fontWeight": "400", "lineHeight": "1.5" },
      "caption": { "fontSize": "0.75rem", "fontWeight": "500", "letterSpacing": "0.05em" }
    },
    "radii": {
      "sm": "0.375rem",
      "md": "0.75rem",
      "lg": "1rem",
      "xl": "1.25rem",
      "full": "9999px"
    },
    "shadows": {
      "card": "0 10px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 10px -6px rgba(0, 0, 0, 0.3)",
      "glowPrimary": "0 0 20px rgba(16, 185, 129, 0.3)"
    }
  },
  "children": [
    {
      "id": "comp-button-primary",
      "type": "frame",
      "name": "Button Primary",
      "reusable": true,
      "layout": "row",
      "alignItems": "center",
      "justifyContent": "center",
      "padding": { "top": 12, "right": 20, "bottom": 12, "left": 20 },
      "background": "#10B981",
      "borderRadius": "0.75rem",
      "boxShadow": "0 0 15px rgba(16, 185, 129, 0.3)",
      "children": [
        {
          "id": "btn-label",
          "type": "text",
          "content": "Acción Principal",
          "color": "#064E3B",
          "fontWeight": "700",
          "fontSize": "0.875rem"
        }
      ]
    },
    {
      "id": "comp-kpi-card",
      "type": "frame",
      "name": "KPI Card",
      "reusable": true,
      "layout": "column",
      "padding": 24,
      "background": "rgba(17, 24, 39, 0.75)",
      "border": "1px solid rgba(255, 255, 255, 0.08)",
      "borderRadius": "1.25rem",
      "backdropFilter": "blur(16px)",
      "boxShadow": "0 10px 25px -5px rgba(0, 0, 0, 0.4)",
      "children": [
        {
          "id": "kpi-header",
          "type": "frame",
          "layout": "row",
          "justifyContent": "space-between",
          "alignItems": "center",
          "children": [
            {
              "id": "kpi-title",
              "type": "text",
              "content": "PLANTAS EN CULTIVO",
              "color": "#9CA3AF",
              "fontSize": "0.75rem",
              "fontWeight": "600",
              "letterSpacing": "0.05em"
            },
            {
              "id": "kpi-badge",
              "type": "frame",
              "padding": { "top": 4, "right": 10, "bottom": 4, "left": 10 },
              "background": "rgba(16, 185, 129, 0.15)",
              "borderRadius": "9999px",
              "border": "1px solid rgba(16, 185, 129, 0.3)",
              "children": [
                {
                  "id": "badge-text",
                  "type": "text",
                  "content": "+12.4%",
                  "color": "#34D399",
                  "fontSize": "0.75rem",
                  "fontWeight": "600"
                }
              ]
            }
          ]
        },
        {
          "id": "kpi-val",
          "type": "text",
          "content": "1,420",
          "color": "#F9FAFB",
          "fontSize": "2.25rem",
          "fontWeight": "800",
          "marginTop": 12
        },
        {
          "id": "kpi-sub",
          "type": "text",
          "content": "Distribuidas en 4 salas activas",
          "color": "#6B7280",
          "fontSize": "0.8rem",
          "marginTop": 6
        }
      ]
    }
  ]
}
